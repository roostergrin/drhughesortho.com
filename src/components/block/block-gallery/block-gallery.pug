.block-gallery
  .block-gallery__waypoint(v-waypoint='{ active: true, callback: onWaypoint }')
  .block-gallery__title Smile Gallery
  .block-gallery__container
    Carousel(:navigationEnabled='true', :autoplay='false', :perPage='1', :loop='true', :navigationNextLabel='arrowNext', :navigationPrevLabel='arrowPrev', paginationActiveColor='#0f878e', paginationColor='#000', :paginationSize='10', :perPageCustom="[[350, 1], [600, 2], [1024, 4]]")
      Slide(v-for='(image, i) in props.gallery', :key='i')
        img.block-gallery__image(:src='image.image', :style="{ transitionDelay: i * 0.2 + 's' }", :class="{ 'block-gallery__image--active': fadeImage }")

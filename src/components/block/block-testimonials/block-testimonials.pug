.block-testimonials
  .block-testimonials__partial-background
  .block-testimonials__container
    .block-testimonials__title(v-html='props.title')
    .block-testimonials__testimonials
      Carousel(:navigationEnabled='true', :autoplay='false', :perPage='1', :loop='true', :navigationNextLabel='arrowNext', :navigationPrevLabel='arrowPrev', paginationActiveColor='#0f878e', paginationColor='#000', :paginationSize='10', :perPageCustom="[[350, 1], [768, 2], [1024, 3]]")
        Slide(v-for='(testimonial, i) in props.testimonials', :key='i')
          .block-testimonials__testimonial
            .block-testimonials__quotes
              Icon(name='Quotes')
            .block-testimonials__image(:style="{ backgroundImage: 'url(' + testimonial.image + ')' }")
            .block-testimonials__review(v-html='testimonial.review')
            .block-testimonials__name(v-html='testimonial.name')
